# Edge Functions secrets (local: copy to supabase/functions/.env ; cloud: `supabase secrets set`).
# DO NOT commit the real .env.

# MercadoLibre app credentials (https://developers.mercadolibre.com.ar)
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=http://127.0.0.1:7431/functions/v1/oauth-callback
ML_SITE_ID=MLA
ML_API_BASE=https://api.mercadolibre.com
ML_AUTH_BASE=https://auth.mercadolibre.com.ar

# Deep link back into the Flutter app after OAuth.
APP_BASE_URL=stockforml://auth-callback

# FX provider (Argentina dollar). Change /blue for /oficial, /bolsa (MEP), etc.
FX_PROVIDER_URL=https://dolarapi.com/v1/dolares/blue

# Anthropic (LLM fallback classifier — classify-product). Optional feature.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically by the
# Edge runtime; no need to set them here for local `supabase functions serve`.
