# Configuración de la app por entorno (via --dart-define-from-file).
# Copiar a .env.local / .env.prod (gitignoreados) y completar.
# Los usa scripts/app.ps1:  .\scripts\app.ps1 -Entorno prod

# Stack local de `supabase start` (el emulador Android reescribe 127.0.0.1
# a 10.0.2.2 solo; un dispositivo físico necesita la IP LAN de tu PC).
SUPABASE_URL=http://127.0.0.1:7431

# Local: la publishable key que imprime `supabase status`.
# Cloud: la publishable/anon key del proyecto (Settings → API).
SUPABASE_ANON_KEY=sb_publishable_xxx
