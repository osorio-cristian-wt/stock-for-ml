default_platform(:ios)

APP_ID = "com.stockforml.stockForMl"

platform :ios do
  desc "Build the app and upload it to TestFlight"
  lane :beta do
    # Creates a temporary keychain on CI runners.
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY"],
      is_key_content_base64: true
    )

    # Pull the distribution certificate + provisioning profile from the
    # private match repo (read-only on CI).
    match(
      type: "appstore",
      app_identifier: APP_ID,
      git_url: ENV["MATCH_GIT_URL"],
      readonly: true,
      api_key: api_key
    )

    # Build number = CI run number (fallback to a timestamp for local runs).
    increment_build_number(
      xcodeproj: "Runner.xcodeproj",
      build_number: ENV["BUILD_NUMBER"] || Time.now.strftime("%Y%m%d%H%M")
    )

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          APP_ID => "match AppStore #{APP_ID}"
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
